{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/mika/.config/fastfetch/logo.png",
    "width": 23,
    "height": 15,
    "preserveAspectRatio": true,
    "padding": {
      "top": 0,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;196;184;244",
      "output": "38;2;245;238;255"
    }
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
      "format": ""
    },
    {
      "key": "│  user    │",
      "type": "title",
      "format": "{user-name}"
    },
    {
      "key": "│ 󰇅 hname   │",
      "type": "custom",
      "format": "archlinux"
    },
    {
      "key": "│ 󰅐 uptime  │",
      "type": "uptime"
    },
    {
      "key": "│  distro  │",
      "type": "os"
    },
    {
      "key": "│  kernel  │",
      "type": "kernel"
    },
    {
      "key": "│  term    │",
      "type": "terminal"
    },
    {
      "key": "│  shell   │",
      "type": "shell"
    },
    {
      "key": "│ 󰍛 cpu     │",
      "type": "cpu",
      "showPeCoreCount": true
    },
    {
      "key": "│ 󰉉 disk    │",
      "type": "disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    {
      "key": "│  memory  │",
      "type": "memory"
    },
    {
      "key": "├───────────┤",
      "type": "custom",
      "format": ""
    },
    {
      "key": "│ 󰏘 colors  │",
      "type": "custom",
      "format": "\u001b[38;2;245;218;230m● \u001b[38;2;232;197;226m● \u001b[38;2;196;184;244m● \u001b[38;2;179;187;232m● \u001b[38;2;157;183;216m● \u001b[38;2;218;187;224m● \u001b[38;2;171;177;211m● \u001b[38;2;142;147;179m●\u001b[0m"
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
      "format": ""
    }
  ]
}
